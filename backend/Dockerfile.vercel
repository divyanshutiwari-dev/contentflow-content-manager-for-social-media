# ==========================================
# Vercel Container Runtime: Java 21 Spring Boot 3
# ==========================================
FROM maven:3.9.9-eclipse-temurin-21-alpine AS builder

WORKDIR /build

# Cache Maven dependencies
COPY pom.xml .
RUN mvn dependency:go-offline -B

# Copy source code and build production jar
COPY src ./src
RUN mvn clean package -DskipTests -B

# ==========================================
# Runtime Stage
# ==========================================
FROM eclipse-temurin:21-jre-alpine AS runner

WORKDIR /app

# Non-root application user and data directory
RUN addgroup -S spring && adduser -S spring -G spring && \
    mkdir -p /app/data && chown -R spring:spring /app

USER spring:spring

COPY --from=builder /build/target/contentflow-backend-1.0.0.jar /app/app.jar

# Vercel injects $PORT at runtime
ENV PORT=8080 \
    SPRING_PROFILES_ACTIVE=prod \
    JAVA_OPTS="-Xms256m -Xmx512m"

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
